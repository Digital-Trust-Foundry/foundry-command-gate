{
  "description": "Deny the commands named in the plugin settings until a Foundry Wallet signer approves the exact command.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/foundry-gate\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/foundry-gate\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
